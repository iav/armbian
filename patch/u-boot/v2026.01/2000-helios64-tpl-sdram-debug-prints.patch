From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex Bot <bot@example.com>
Date: Thu, 25 Dec 2025 00:00:00 +0000
Subject: [PATCH] rk3399: helios64: add TPL DDR debug prints and skip freq sel

Add verbose logging around rk3399 TPL DDR bring-up so we can see how far
Helios64 progresses before failure. While debugging, skip the frequency
selection write that hangs on this board.

diff --git a/drivers/ram/rockchip/sdram_rk3399.c b/drivers/ram/rockchip/sdram_rk3399.c
index 0f6ff53d55..ffffffffffff 100644
--- a/drivers/ram/rockchip/sdram_rk3399.c
+++ b/drivers/ram/rockchip/sdram_rk3399.c
@@ -906,6 +906,9 @@
 	struct rk3399_sdram_params *params_cfg;
 	u32 byte;
 
+	puts(channel ? "RK3399: pctl_cfg ch1: enter\n" :
+		       "RK3399: pctl_cfg ch0: enter\n");
+
 	dram->ops->modify_param(chan, params);
 	/*
 	 * work around controller bug:
@@ -914,6 +917,8 @@
 	sdram_copy_to_reg(&denali_ctl[1], &params_ctl[1],
 			  sizeof(struct rk3399_ddr_pctl_regs) - 4);
 	writel(params_ctl[0], &denali_ctl[0]);
+	puts(channel ? "RK3399: pctl_cfg ch1: ctl regs done\n" :
+		       "RK3399: pctl_cfg ch0: ctl regs done\n");
 
 	/*
 	 * two channel init at the same time, then ZQ Cal Start
@@ -928,12 +933,16 @@
 		tmp1 = readl(&denali_ctl[14]);
 		writel(tmp + tmp1, &denali_ctl[14]);
 	}
+	puts(channel ? "RK3399: pctl_cfg ch1: pi copy\n" :
+		       "RK3399: pctl_cfg ch0: pi copy\n");
 
 	sdram_copy_to_reg(denali_pi, &params->pi_regs.denali_pi[0],
 			  sizeof(struct rk3399_ddr_pi_regs));
 
 	/* rank count need to set for init */
 	set_memory_map(chan, channel, params);
+	puts(channel ? "RK3399: pctl_cfg ch1: map set\n" :
+		       "RK3399: pctl_cfg ch0: map set\n");
 
 	writel(params->phy_regs.denali_phy[910], &denali_phy[910]);
 	writel(params->phy_regs.denali_phy[911], &denali_phy[911]);
@@ -943,6 +952,8 @@
 		writel(params->phy_regs.denali_phy[898], &denali_phy[898]);
 		writel(params->phy_regs.denali_phy[919], &denali_phy[919]);
 	}
+	puts(channel ? "RK3399: pctl_cfg ch1: pre-reset regs\n" :
+		       "RK3399: pctl_cfg ch0: pre-reset regs\n");
 
 	dram->pwrup_srefresh_exit[channel] = readl(&denali_ctl[68]) &
 					     PWRUP_SREFRESH_EXIT;
@@ -953,6 +964,8 @@
 
 	setbits_le32(&denali_pi[0], START);
 	setbits_le32(&denali_ctl[0], START);
+	puts(channel ? "RK3399: pctl_cfg ch1: start set\n" :
+		       "RK3399: pctl_cfg ch0: start set\n");
 
 	/**
 	 * LPDDR4 use PLL bypass mode for init
@@ -960,6 +973,8 @@
 	 */
 	if (params->base.dramtype != LPDDR4) {
 		/* Waiting for phy DLL lock */
+		puts(channel ? "RK3399: pctl_cfg ch1: wait dll lock\n" :
+			       "RK3399: pctl_cfg ch0: wait dll lock\n");
 		while (1) {
 			tmp = readl(&denali_phy[920]);
 			tmp1 = readl(&denali_phy[921]);
@@ -970,6 +985,8 @@
 			    (((tmp2 >> 0) & 0x1) == 0x1))
 				break;
 		}
+		puts(channel ? "RK3399: pctl_cfg ch1: dll lock ok\n" :
+			       "RK3399: pctl_cfg ch0: dll lock ok\n");
 	}
 
 	sdram_copy_to_reg(&denali_phy[896], &params_phy[896], (958 - 895) * 4);
@@ -986,15 +1003,24 @@
 			  (677 - 640 + 1) * 4);
 	sdram_copy_to_reg(&denali_phy[768], &params_phy[768],
 			  (805 - 768 + 1) * 4);
+	puts(channel ? "RK3399: pctl_cfg ch1: phy table copy done\n" :
+		       "RK3399: pctl_cfg ch0: phy table copy done\n");
 
+	puts(channel ? "RK3399: pctl_cfg ch1: get idx params\n" :
+		       "RK3399: pctl_cfg ch0: get idx params\n");
 	if (params->base.dramtype == LPDDR4)
 		params_cfg = dram->ops->get_phy_index_params(1, params);
 	else
 		params_cfg = dram->ops->get_phy_index_params(0, params);
+	puts(channel ? "RK3399: pctl_cfg ch1: got idx params\n" :
+		       "RK3399: pctl_cfg ch0: got idx params\n");
 
-	clrsetbits_le32(&params_cfg->phy_regs.denali_phy[896], 0x3 << 8,
-			0 << 8);
-	writel(params_cfg->phy_regs.denali_phy[896], &denali_phy[896]);
+	puts(channel ? "RK3399: pctl_cfg ch1: set freq sel\n" :
+		       "RK3399: pctl_cfg ch0: set freq sel\n");
+	puts(channel ? "RK3399: pctl_cfg ch1: skip freq sel (debug)\n" :
+		       "RK3399: pctl_cfg ch0: skip freq sel (debug)\n");
+	puts(channel ? "RK3399: pctl_cfg ch1: phy index adjust (skipped)\n" :
+		       "RK3399: pctl_cfg ch0: phy index adjust (skipped)\n");
 
 	writel(params->phy_regs.denali_phy[83] + (0x10 << 16),
 	       &denali_phy[83]);
@@ -1012,6 +1038,8 @@
 	       &denali_phy[467]);
 	writel(params->phy_regs.denali_phy[468] + (0x10 << 8),
 	       &denali_phy[468]);
+	puts(channel ? "RK3399: pctl_cfg ch1: dqs phase adjust\n" :
+		       "RK3399: pctl_cfg ch0: dqs phase adjust\n");
 
 	if (params->base.dramtype == LPDDR4) {
 		/*
@@ -1034,6 +1062,9 @@
 					(PHY_DRV_ODT_240 << 0x4));
 	}
 
+	puts(channel ? "RK3399: pctl_cfg ch1: done\n" :
+		       "RK3399: pctl_cfg ch0: done\n");
+
 	return 0;
 }
 
@@ -2915,6 +2946,8 @@
 	int channel, ch, rank;
 	u32 tmp, ret;
 
+	puts("RK3399: sdram_init: start\n");
+
 	debug("Starting SDRAM initialization...\n");
 
 	if ((dramtype == DDR3 && ddr_freq > 933) ||
@@ -2926,21 +2959,34 @@
 
 	/* detect rank */
 	for (ch = 0; ch < 2; ch++) {
+		puts(ch ? "RK3399: sdram_init: rank loop ch1\n" :
+			  "RK3399: sdram_init: rank loop ch0\n");
 		params->ch[ch].cap_info.rank = 2;
 		for (rank = 2; rank != 0; rank--) {
 			for (channel = 0; channel < 2; channel++) {
+				puts(channel ? "RK3399: sdram_init: chan1 pre-reset\n" :
+					       "RK3399: sdram_init: chan0 pre-reset\n");
 				const struct chan_info *chan =
 					&dram->chan[channel];
 				struct rockchip_cru *cru = dram->cru;
 				struct rk3399_ddr_publ_regs *publ = chan->publ;
 
 				phy_pctrl_reset(cru, channel);
+				puts(channel ? "RK3399: sdram_init: chan1 post-reset\n" :
+					       "RK3399: sdram_init: chan0 post-reset\n");
 				phy_dll_bypass_set(publ, ddr_freq);
+				puts(channel ? "RK3399: sdram_init: chan1 dll_bypass\n" :
+					       "RK3399: sdram_init: chan0 dll_bypass\n");
+				puts(channel ? "RK3399: sdram_init: chan1 pctl_cfg start\n" :
+					       "RK3399: sdram_init: chan0 pctl_cfg start\n");
 				pctl_cfg(dram, chan, channel, params);
+				puts(channel ? "RK3399: sdram_init: chan1 pctl_cfg done\n" :
+					       "RK3399: sdram_init: chan0 pctl_cfg done\n");
 			}
 
 			/* start to trigger initialization */
 			pctl_start(dram, params, 3);
+			puts("RK3399: sdram_init: pctl_start\n");
 
 			/* LPDDR2/LPDDR3 need to wait DAI complete, max 10us */
 			if (dramtype == LPDDR3)
@@ -2951,6 +2997,7 @@
 				    params->base.dramtype);
 			params->ch[ch].cap_info.rank = rank;
 
+			puts("RK3399: sdram_init: data_training_first\n");
 			ret = dram->ops->data_training_first(dram, ch,
 							     rank, params);
 			if (!ret) {
@@ -2962,6 +3009,7 @@
 		/* Computed rank with associated channel number */
 		params->ch[ch].cap_info.rank = rank;
 	}
+	puts("RK3399: sdram_init: rank detect done\n");
 
 #if defined(CONFIG_RAM_ROCKCHIP_LPDDR4)
 	/* LPDDR4 needs to be trained at 400MHz */
@@ -3008,6 +3056,7 @@
 		set_ddrconfig(chan, params, channel, cap_info->ddrconfig);
 		set_cap_relate_config(chan, params, channel);
 	}
+	puts("RK3399: sdram_init: channel detect done\n");
 
 	if (params->base.num_channels == 0) {
 		printf("%s: ", __func__);
@@ -3015,6 +3064,7 @@
 		printf(" - %dMHz failed!\n", params->base.ddr_freq);
 		return -EINVAL;
 	}
+	puts("RK3399: sdram_init: channels OK\n");
 
 	params->base.stride = calculate_stride(params);
 	dram_all_config(dram, params);
@@ -3022,8 +3072,10 @@
 	ret = dram->ops->set_rate_index(dram, params, 1);
 	if (ret)
 		return ret;
+	puts("RK3399: sdram_init: set_rate_index done\n");
 
 	debug("Finish SDRAM initialization...\n");
+	puts("RK3399: sdram_init: finish\n");
 	return 0;
 }
 
-- 
2.34.1
