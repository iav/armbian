From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Velkov <iav@iav.lv>
Date: Sat, 03 Oct 2026 22:43:30 +0000
Subject: power: reset: meson64-reboot: port to gpiod

The driver stopped building on 7.x when <linux/of_gpio.h> was removed.
Port it to the descriptor API and keep only the SD card power cycle on
restart.

The lines belong to the SD regulators, and regulator-gpio requests the
IO voltage switch exclusively, so take them shared and only at restart:
a SYS_OFF_MODE_RESTART_PREPARE handler runs after device_shutdown() and
may sleep. The power-off override with the vendor SiP call is dropped;
power-off keeps using PSCI. On ODROID-HC4 with 6.18.55 the override
hung `poweroff` after "reboot: Power down".

Assisted-by: LLM
Signed-off-by: Igor Velkov <iav@iav.lv>
---
 drivers/power/reset/Kconfig          |   6 +-
 drivers/power/reset/meson64-reboot.c | 173 +++++++--------------------
 2 files changed, 49 insertions(+), 130 deletions(-)

diff --git a/drivers/power/reset/Kconfig b/drivers/power/reset/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/power/reset/Kconfig
+++ b/drivers/power/reset/Kconfig
@@ -169,11 +169,11 @@ config POWER_RESET_ODROID_GO_ULTRA_POWEROFF
 	  This driver supports Power off for Odroid Go Ultra device.
 
 config POWER_RESET_MESON64
-	bool "Meson64 reboot/power-off driver"
+	bool "Meson64 SD card power cycle on restart"
 	depends on ARCH_MESON
 	help
-	  The driver supports restart / power off for amlogic
-	  g12a, g12b and sm1 SoCs
+	  Power-cycles the SD card on restart, so that the boot ROM
+	  of Amlogic g12a, g12b and sm1 boards can read it.
 
 config POWER_RESET_PIIX4_POWEROFF
 	tristate "Intel PIIX4 power-off driver"
diff --git a/drivers/power/reset/meson64-reboot.c b/drivers/power/reset/meson64-reboot.c
index 111111111111..222222222222 100644
--- a/drivers/power/reset/meson64-reboot.c
+++ b/drivers/power/reset/meson64-reboot.c
@@ -19,149 +19,74 @@
 
 #include <linux/delay.h>
 #include <linux/err.h>
-#include <linux/init.h>
-#include <linux/kernel.h>
-#include <linux/io.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
-#include <linux/module.h>
 #include <linux/reboot.h>
 
-#include <asm/system_misc.h>
-
-#include <asm/compiler.h>
-#include <linux/kdebug.h>
-#include <linux/arm-smccc.h>
-
-#include <linux/gpio.h>
-#include <linux/of_gpio.h>
-
-int sd_vqsw;
-int sd_vmmc;
-int sd_vqen;
-
-static u32 psci_function_id_restart;
-static u32 psci_function_id_poweroff;
-
-#define CHECK_RET(ret) { \
-	if (ret) \
-	pr_err("[%s] gpio op failed(%d) at line %d\n",\
-			__func__, ret, __LINE__); \
-}
-
-static noinline int __invoke_psci_fn_smc(u64 function_id, u64 arg0, u64 arg1,
-					 u64 arg2)
+/*
+ * The SD card supply and IO lines belong to regulators, so take them shared,
+ * and only at restart time: the regulator for the IO voltage switch requests
+ * its line exclusively at probe.
+ */
+static struct gpio_desc *meson64_get_line(struct device *dev, const char *con_id)
 {
-	struct arm_smccc_res res;
+	struct gpio_desc *desc;
 
-	arm_smccc_smc((unsigned long)function_id,
-			(unsigned long)arg0,
-			(unsigned long)arg1,
-			(unsigned long)arg2,
-			0, 0, 0, 0, &res);
-	return res.a0;
+	desc = gpiod_get_optional(dev, con_id, GPIOD_ASIS | GPIOD_FLAGS_BIT_NONEXCLUSIVE);
+	if (IS_ERR(desc)) {
+		dev_err(dev, "%s: %pe\n", con_id, desc);
+		return NULL;
+	}
+	return desc;
 }
 
-void meson64_card_reset(void)
+/*
+ * Power-cycle the SD card and leave it powered, so that the boot ROM finds it
+ * in its power-on state after the reset.
+ */
+static int meson64_card_reset(struct sys_off_data *data)
 {
-	int ret = 0;
+	struct device *dev = data->cb_data;
+	struct gpio_desc *vqsw, *vmmc, *vqen;
+
+	vqsw = meson64_get_line(dev, "sd-vqsw");
+	vmmc = meson64_get_line(dev, "sd-vmmc");
+	vqen = meson64_get_line(dev, "sd-vqen");
 
-	if ((sd_vqsw == 0) && (sd_vmmc == 0))
-		return;
+	if (!vqsw || !vmmc)
+		return NOTIFY_DONE;
 
-	if (sd_vqen == 0) {
-		gpio_free(sd_vqsw);
-		gpio_free(sd_vmmc);
-		ret = gpio_request_one(sd_vqsw,
-				GPIOF_OUT_INIT_LOW, "REBOOT");
-		CHECK_RET(ret);
+	if (!vqen) {
+		gpiod_direction_output_raw(vqsw, 0);
 		mdelay(10);
-		ret = gpio_direction_output(sd_vqsw, 1);
-		CHECK_RET(ret);
-		ret = gpio_request_one(sd_vmmc,
-				GPIOF_OUT_INIT_LOW, "REBOOT");
-		CHECK_RET(ret);
+		gpiod_direction_output_raw(vqsw, 1);
+		gpiod_direction_output_raw(vmmc, 0);
 		mdelay(10);
-		ret = gpio_direction_output(sd_vqsw, 0);
-		CHECK_RET(ret);
-		ret = gpio_direction_output(sd_vmmc, 1);
-		CHECK_RET(ret);
+		gpiod_direction_output_raw(vqsw, 0);
+		gpiod_direction_output_raw(vmmc, 1);
 		mdelay(5);
-		gpio_free(sd_vqsw);
-		gpio_free(sd_vmmc);
 	} else {
-		gpio_free(sd_vqsw);
-		gpio_free(sd_vqen);
-		gpio_free(sd_vmmc);
-
-		ret = gpio_request_one(sd_vqsw,
-				GPIOF_OUT_INIT_LOW, "REBOOT");
-		CHECK_RET(ret);
-		ret = gpio_request_one(sd_vqen,
-				GPIOF_OUT_INIT_LOW, "REBOOT");
-		CHECK_RET(ret);
-		ret = gpio_request_one(sd_vmmc,
-				GPIOF_OUT_INIT_LOW, "REBOOT");
-		CHECK_RET(ret);
+		gpiod_direction_output_raw(vqsw, 0);
+		gpiod_direction_output_raw(vqen, 0);
+		gpiod_direction_output_raw(vmmc, 0);
 		mdelay(100);
-		ret = gpio_direction_input(sd_vqen);
-		CHECK_RET(ret);
-		ret = gpio_direction_input(sd_vmmc);
-		CHECK_RET(ret);
-		ret = gpio_direction_input(sd_vqsw);
-		CHECK_RET(ret);
+		gpiod_direction_input(vqen);
+		gpiod_direction_input(vmmc);
+		gpiod_direction_input(vqsw);
 		mdelay(5);
-		gpio_free(sd_vqen);
-		gpio_free(sd_vmmc);
-		gpio_free(sd_vqsw);
 	}
-}
 
-static int do_meson64_restart(struct notifier_block *this, unsigned long mode, void *cmd)
-{
-	meson64_card_reset();
 	return NOTIFY_DONE;
 }
 
-static struct notifier_block meson64_restart_handler = {
-	.notifier_call = do_meson64_restart,
-	.priority = 130,
-};
-
-static void do_meson64_poweroff(void)
-{
-	meson64_card_reset();
-
-	__invoke_psci_fn_smc(0x82000042, 1, 0, 0);
-}
-
 static int meson64_restart_probe(struct platform_device *pdev)
 {
-	struct device_node *of_node;
-	u32 id;
-
-	if (!of_property_read_u32(pdev->dev.of_node, "sys_reset", &id)) {
-		psci_function_id_restart = id;
-		register_restart_handler(&meson64_restart_handler);
-	}
-
-	if (!of_property_read_u32(pdev->dev.of_node, "sys_poweroff", &id)) {
-		psci_function_id_poweroff = id;
-		pm_power_off = do_meson64_poweroff;
-	}
-
-	of_node = pdev->dev.of_node;
-
-	sd_vqsw = of_get_named_gpio(of_node, "sd-vqsw", 0);
-	if (!gpio_is_valid(sd_vqsw)) sd_vqsw = 0;
-
-	sd_vmmc = of_get_named_gpio(of_node, "sd-vmmc", 0);
-	if (!gpio_is_valid(sd_vmmc)) sd_vmmc = 0;
-
-	sd_vqen = of_get_named_gpio(of_node, "sd-vqen", 0);
-	if (!gpio_is_valid(sd_vqen)) sd_vqen = 0;
-
-	return 0;
+	return devm_register_sys_off_handler(&pdev->dev,
+					     SYS_OFF_MODE_RESTART_PREPARE,
+					     SYS_OFF_PRIO_DEFAULT,
+					     meson64_card_reset, &pdev->dev);
 }
 
 static const struct of_device_id of_meson64_restart_match[] = {
@@ -174,13 +99,7 @@ static struct platform_driver meson64_restart_driver = {
 	.probe = meson64_restart_probe,
 	.driver = {
 		.name = "meson64-restart",
-		.of_match_table = of_match_ptr(of_meson64_restart_match),
+		.of_match_table = of_meson64_restart_match,
 	},
 };
-
-static int __init meson64_restart_init(void)
-{
-	return platform_driver_register(&meson64_restart_driver);
-}
-device_initcall(meson64_restart_init);
-
+builtin_platform_driver(meson64_restart_driver);
-- 
